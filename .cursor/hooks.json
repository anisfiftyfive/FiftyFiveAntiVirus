{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/protect-shell.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/protect-read.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/scan-secrets.py",
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/lint-after-edit.py",
        "timeout": 180,
        "matcher": "\\.(kt|kts|xml)$"
      }
    ]
  }
}
